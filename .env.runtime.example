# Copy to .env.runtime on the persistent Linux host. Never commit real tokens.

# Alpaca Paper only. Never put LIVE credentials here.
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=
ALPACA_API_TIMEOUT=8

# Required to authorize private /api/alpaca/* routes. Generate a long random value.
MIRACOLO_API_TOKEN=

# Cloudflare Zero Trust > Networks > Tunnels > your tunnel > Install connector.
# Paste the tunnel token here. Configure its public hostname to route to http://localhost:8080.
CLOUDFLARE_TUNNEL_TOKEN=
